{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teknefest-landing",
  "account_id": "e0518b2d86bc53918e6310ce77ffbed7",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tac.ibtikar.tr",
      "custom_domain": true
    }
  ]
}
