{
  "name": "kitchen-backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply teknofest-kitchen --local",
    "db:migrate:remote": "wrangler d1 migrations apply teknofest-kitchen --remote"
  },
  "dependencies": {
    "hono": "^4.11.3"
  },
  "devDependencies": {
    "wrangler": "^4.4.0"
  }
}
