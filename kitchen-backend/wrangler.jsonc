{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teknofest-kitchen-be",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "dev": {
    "port": 9680
  },
  "vars": {
    "APP_NAME": "teknofest-kitchen",
    "VMS_API_BASE": "http://localhost:5931/ms/membership-app/api"
  },
  "services": [
    {
      "binding": "LIBRARY",
      "service": "teknofest-library-be-main"
    },
    {
      "binding": "VMS_SERVICE",
      "service": "ibtikar-membership-be"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "teknofest-kitchen",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    },
    {
      "binding": "VMS_DB",
      "database_name": "vms-database",
      "database_id": "bbd89415-677e-4991-bb11-ea1be7e2d095",
      "remote": true
    },
    {
      "binding": "MEMBERS_DB",
      "database_name": "membership-app-database",
      "database_id": "bb86e7a4-11e2-4d80-88b8-c376a19994dd",
      "remote": true
    }
  ]
}
