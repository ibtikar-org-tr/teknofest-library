PORT=9666

# local | remote — local uses wrangler D1 sqlite (same DB as library-be-main-hono offline)
CLOUDFLARE_D1_MODE=local
# Optional: pin the sqlite file; otherwise auto-detect under ../library-be-main-hono/.wrangler/...
# CLOUDFLARE_D1_SQLITE_PATH=

CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_D1_DATABASE_ID=your_database_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

BUCKET_LINK=https://files.ibtikar.tr/teknofest-library
